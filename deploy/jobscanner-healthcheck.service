[Unit]
Description=Job Scanner Web-UI Healthcheck
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/opt/jobscanner
EnvironmentFile=/root/projekte/telegram-bot-army/.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/jobscanner/deploy/healthcheck.sh
StandardOutput=journal
StandardError=journal
