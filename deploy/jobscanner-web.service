[Unit]
Description=Job Scanner Web-UI
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/projekte/job-scanner
EnvironmentFile=/root/projekte/telegram-bot-army/.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 -m uvicorn jobscanner.web.app:create_app --factory --host 127.0.0.1 --port 8010
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
