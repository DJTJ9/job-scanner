[Unit]
Description=Job Scanner Scoring-Agent (Claude-Code-Batch-Lauf, ersetzt Groq)
After=network.target jobscanner-discover.service
OnFailure=jobscanner-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/jobscanner
EnvironmentFile=/root/projekte/telegram-bot-army/.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/root/.nvm/versions/node/v24.16.0/bin
ExecStart=/opt/jobscanner/deploy/run_scoring_agent.sh
StandardOutput=journal
StandardError=journal
