[Unit]
Description=Job Scanner Sofort-Notify (starke Treffer nach Scoring-Agent)
After=network.target jobscanner-scoring-agent.service
Wants=jobscanner-scoring-agent.service
OnFailure=jobscanner-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/jobscanner
EnvironmentFile=/root/projekte/telegram-bot-army/.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 -m jobscanner.notify_immediate
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=jobscanner-scoring-agent.service
