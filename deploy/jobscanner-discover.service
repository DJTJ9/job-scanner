[Unit]
Description=Job Scanner Discover-Cron (Fetch/Scrape/Dedup, kein LLM)
After=network.target
OnFailure=jobscanner-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/root/projekte/job-scanner
EnvironmentFile=/root/projekte/telegram-bot-army/.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 -m jobscanner.pipeline
ExecStartPost=/root/projekte/job-scanner/deploy/check_errors.sh
StandardOutput=journal
StandardError=journal
